  --card: #ffffff;
  --card-hover: #fafafa;
  --ink: #1d1d1f;
  --muted: #86868b;
  --line: #e5e5ea;
  --accent: #ffd100;
  --accent-glow: rgba(255, 209, 0, 0.2);
  --accent-hover: #e5bd00;
  --dark-ink: #111113;
  --red: #ff3b30;
  --red2: rgba(255, 59, 48, 0.12);
  --amber: #ff9f0a;
  --ok: #34c759;
  --shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
